            text_families : [FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Ui, FontFamily.Mono],
            text_family_names : ["ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif", "ui-monospace, \"Cascadia Mono\", \"SF Mono\", Menlo, Consolas, \"DejaVu Sans Mono\", monospace"],
            text_italics : [false, false, false, false, false, false, false, false, false, false],
            text_features : [TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }, TextFeatures { ligatures : false, tabular_numbers : false, slashed_zero : false, stylistic_set : 0u8, raw_tags : zeroed<[0]u32>() }],
            text_tab_sizes : [4u8, 4u8, 4u8, 4u8, 4u8, 4u8, 4u8, 4u8, 4u8, 4u8],
            elevation_data : [ shadow_pack(Shadow { x : 0.0f, y : 0.0f, blur : 0.0f, spread : 0.0f, color : Color { r : 0u8, g : 0u8, b : 0u8, a : 0u8 } }), shadow_pack(Shadow { x : 0.0f, y : 0.0f, blur : 0.0f, spread : 0.0f, color : Color { r : 0u8, g : 0u8, b : 0u8, a : 0u8 } }), shadow_pack(Shadow { x : 0.0f, y : 0.0f, blur : 0.0f, spread : 0.0f, color : Color { r : 0u8, g : 0u8, b : 0u8, a : 0u8 } }), shadow_pack(Shadow { x : 0.0f, y : 0.0f, blur : 0.0f, spread : 0.0f, color : Color { r : 0u8, g : 0u8, b : 0u8, a : 0u8 } }) ],
            motions : [120.0f, 160.0f, 240.0f, 220.0f],
            density_value : Density.Comfortable,
            scale_value : 1.0f,
            disabled_value : 0.4f,
            compact_value : false
        }
    }

    public func color(&self, t : ColorToken) : Color { return self.colors[t as size_t] }

    public func space(&self, s : Space) : float {
        if(self.compact_value) { return self.compact_spaces[s as size_t] }
        return self.spaces[s as size_t]
    }

    public func radius(&self, r : Radius) : float { return self.radii[r as size_t] }

    public func text(&self, r : TextRole) : TextStyle {
        var ix = r as size_t
        var size = self.text_sizes[ix] * self.scale_value
        var line = self.text_lines[ix] * self.scale_value
        var line_height = 1.0f
        if(self.text_sizes[ix] != 0.0f) { line_height = self.text_lines[ix] / self.text_sizes[ix] }
        return TextStyle {
            family : self.text_families[ix],
            family_name : self.text_family_names[ix],
            size : size,
            weight : self.text_weights[ix],
            italic : self.text_italics[ix],
            line_height : line_height,
            letter_spacing : self.text_letters[ix],
            features : self.text_features[ix],
            tab_size : self.text_tab_sizes[ix]
        }
    }

    public func elevation(&self, e : Elevation) : Shadow { return shadow_unpack(self.elevation_data[e as size_t]) }
    public func density(&self) : Density { return self.density_value }
    public func text_scale(&self) : float { return self.scale_value }
    public func motion(&self, m : MotionToken) : Duration { return Duration { ms : self.motions[m as size_t] } }
    public func disabled_opacity(&self) : float { return self.disabled_value }

    public func set_color(&mut self, t : ColorToken, c : Color) { self.colors[t as size_t] = c }
    public func set_space(&mut self, s : Space, px : float) {
        self.spaces[s as size_t] = px
        self.compact_spaces[s as size_t] = px
    }
    public func set_radius(&mut self, r : Radius, px : float) { self.radii[r as size_t] = px }
    public func set_text_style(&mut self, role : TextRole, t : TextStyle) {
        var ix = role as size_t
        self.text_sizes[ix] = t.size
        self.text_lines[ix] = t.size * t.line_height
        self.text_weights[ix] = t.weight
        self.text_letters[ix] = t.letter_spacing
        self.text_families[ix] = t.family
        self.text_family_names[ix] = t.family_name
        self.text_italics[ix] = t.italic
        self.text_features[ix] = t.features
        self.text_tab_sizes[ix] = t.tab_size
    }
    public func set_density(&mut self, d : Density) {
        self.density_value = d
        self.compact_value = (d as int) == (Density.Compact as int)
    }
    public func set_text_scale(&mut self, scale : float) { self.scale_value = scale }
}

public namespace ui_internal {
public func breakpoint_for_width(width : u32) : Breakpoint {
    if(width <= UI_BREAKPOINT_SM_MAX) { return Breakpoint.Sm }
    if(width <= UI_BREAKPOINT_MD_MAX) { return Breakpoint.Md }
    if(width <= UI_BREAKPOINT_LG_MAX) { return Breakpoint.Lg }
    return Breakpoint.Xl
}
public func control_height(d : Density, size : u8) : u32 {
    if((d as int) == (Density.Compact as int)) {
        if(size == 0u8) { return UI_COMPACT_CONTROL_SM }
        if(size == 1u8) { return UI_COMPACT_CONTROL_MD }
        return UI_COMPACT_CONTROL_LG
    }
    if(size == 0u8) { return UI_COMFY_CONTROL_SM }
    if(size == 1u8) { return UI_COMFY_CONTROL_MD }
    return UI_COMFY_CONTROL_LG
}
public func table_row_height(d : Density) : u32 { if((d as int) == (Density.Compact as int)) { return UI_COMPACT_TABLE_ROW }; return UI_COMFY_TABLE_ROW }
public func table_header_height(d : Density) : u32 { if((d as int) == (Density.Compact as int)) { return UI_COMPACT_TABLE_HEADER }; return UI_COMFY_TABLE_HEADER }
public func page_padding(b : Breakpoint) : u32 {
    if(b == Breakpoint.Sm) { return UI_PAGE_PADDING_SM }
    if(b == Breakpoint.Md) { return UI_PAGE_PADDING_MD }
    return UI_PAGE_PADDING_LG
}
public func sidebar_width(b : Breakpoint) : u32 { if(b == Breakpoint.Xl) { return UI_SIDEBAR_XL }; return UI_SIDEBAR_LG }
public func focus_width(mode : ThemeMode) : u32 {
    if(mode == ThemeMode.HighContrast) { return UI_FOCUS_WIDTH_HC }
    if(mode == ThemeMode.Dark) { return UI_FOCUS_WIDTH_DARK }
    return UI_FOCUS_WIDTH_LIGHT
}
public func focus_offset(mode : ThemeMode) : u32 {
    if(mode == ThemeMode.HighContrast) { return UI_FOCUS_OFFSET_HC }
    if(mode == ThemeMode.Dark) { return UI_FOCUS_OFFSET_DARK }
    return UI_FOCUS_OFFSET_LIGHT
}
public func border_width(mode : ThemeMode) : u32 { if(mode == ThemeMode.HighContrast) { return UI_BORDER_WIDTH_HC }; return UI_BORDER_WIDTH }
public func min_touch_target() : u32 { return UI_MIN_TOUCH }
public func preferred_touch_target() : u32 { return UI_PREFERRED_TOUCH }
}
