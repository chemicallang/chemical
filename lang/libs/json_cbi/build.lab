import lab
import std

import "@cstd/build.lab" as cstdMod
import "@std/build.lab" as stdMod
import "@compiler/build.lab" as compilerMod

using namespace std;

public func build(ctx : *mut BuildContext, user_job : *mut LabJob) : *mut Module {

    const curr_file_path = lab::get_my_path();
    const previous_module = ctx.get_cached(user_job, &curr_file_path);
    if(previous_module != null) return previous_module;
    const empty_module = ctx.empty_module(std::string_view(""), std::string_view("json_cbi"));
    ctx.set_cached(user_job, &curr_file_path, empty_module)

    const cbi_name = std::string_view("json");
    if(ctx.contains_cbi(&cbi_name)) {
        return empty_module;
    }
    ctx.set_contains_cbi(&cbi_name)

    const controller = ctx.getAnnotationController()
    controller.createMarkerAnnotation(std::string_view("serializable"))

    var cbi = ctx.build_cbi(&cbi_name)
    const job = cbi;

    ctx.put_job_before(job, user_job)

    var std_module = stdMod.build(ctx, job);
    if(std_module == null) {
        return null
    }

    var cstd_module = cstdMod.build(ctx, job);
    if(cstd_module == null) {
        return null
    }

    var compiler_module = compilerMod.build(ctx, job);
    if(compiler_module == null) {
        return null
    }

    const dependencies = [ cstd_module, std_module, compiler_module ]
    var src_path = lab::rel_path_to("src")
    const module = ctx.chemical_dir_module(std::string_view(""), std::string_view("json_cbi"), src_path.to_view(), dependencies);

    ctx.add_module(cbi, module)

    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_parseMacroTopLevelNode"), CBIFunctionType.ParseMacroTopLevelNode);
    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_symResDeclareNode"), CBIFunctionType.SymResDeclareTopLevelNode);
    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_symResLinkSigNode"), CBIFunctionType.SymResLinkSignatureNode);
    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_symResNode"), CBIFunctionType.SymResNode);
    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_replacementNodeDeclare"), CBIFunctionType.ReplacementNodeDeclare);
    ctx.index_cbi_fn(cbi, std::string_view("json"), std::string_view("json_replacementNode"), CBIFunctionType.ReplacementNode);

    return empty_module;

}
