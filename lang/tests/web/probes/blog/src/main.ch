// Probe 2: a content site — 40 generated posts, tag pages, an archive, an about
// page, all pre-rendered, one interactive island shared by the index and the tag
// pages, and markdown bodies rendered with the `md` library.
//
// This is the "static site" half of the flexibility question: how much work is it
// to produce N pages, what does the output cost, and what does the API make you
// write yourself (routing, pagination, per-page head metadata, content loading).
// Measurements are printed; `lang/docs/web-stack-gaps.md` records the gaps.
using std::Option;
using std::Result;
using std::string;
using std::string_view;
using std::vector;

// ── Content ───────────────────────────────────────────────────────────────
@direct_init
struct Post {
    var slug : string
    var title : string
    var tag : string
    var markdown : string
    var minutes : int
}

// 40 posts, generated so the source stays small: real content would come from
// files or a CMS, which is itself part of the finding (there is no content API).
func posts() : vector<Post> {
    var out = vector<Post>()
    var tags = vector<string>()
    tags.push_back(string("engineering"))
    tags.push_back(string("design"))
    tags.push_back(string("notes"))
    tags.push_back(string("release"))
    var i : int = 0
    while(i < 40) {
        var number = i + 1
        var tag = unsafe(&*(tags.get_ptr((i % 4) as ubigint)))
        var tag_copy = tag.copy()
        var slug = string("post-")
        if(number < 10) { slug.append('0') }
        slug.append_integer(number as bigint)

        var title = string("Notes on building things, part ")
        title.append_integer(number as bigint)

        var body = string("# ")
        body.append_string(&title)
        body.append_view("\n\nThis is post ")
        body.append_integer(number as bigint)
        body.append_view(" of a generated series. It exists to measure what a ")
        body.append_view("content site costs: one markdown document, one route, one ")
        body.append_view("shared bundle.\n\n")
        body.append_view("## What we changed\n\n")
        body.append_view("- a list item with **strong** text and a [link](/about/)\n")
        body.append_view("- a second item, so the list renders a real block\n")
        body.append_view("- `code_inline` in a sentence\n\n")
        body.append_view("```chemical\nfunc add(a : int, b : int) : int {\n    return a + b\n}\n```\n\n")
        body.append_view("> A quote block, to give the renderer something with nesting.\n\n")
        body.append_view("Final paragraph with a closing thought and an em dash — done.\n")
        out.push_back(Post {
            slug : slug,
            title : title,
            tag : tag_copy,
            markdown : body,
            minutes : 2 + (i % 5)
        })
        i = i + 1
    }
    return out
}

func no_highlight(lang : string_view, code : string_view) : string {
    return string()
}

func no_rewrite(url : string_view) : string {
    return unsafe(string(url.data(), url.size()))
}

func markdown_html(post : &Post) : string {
    var view = post.markdown.to_view()
    return md::to_html(view, no_highlight, no_rewrite)
}

// ── Shared layout ─────────────────────────────────────────────────────────
// A layout is a function taking the page and a body closure: there is no layout
// or slot mechanism in `page`, so every site invents this.
func layout(page : &mut HtmlPage, title : string_view, body : () => void) {
    page.appendTitle(&title)
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav>
                <a href="/archive/">Archive</a>
                <a href="/about/">About</a>
            </nav>
        </header>
        <main class="content">@{body()}</main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

// The site's only island. Being a universal component, its definition is emitted
// into the shared bundle and its markup is server-rendered here.
#universal SearchBox(props) {
    state q = ""
    return <form class="search" action="/archive/">
        <input type="text" name="q" value={q}
               onChange={(e) => { q = e.target.value }} />
        <span class="hint">filter the archive</span>
    </form>
}

// ── Pages ─────────────────────────────────────────────────────────────────
func render_index(page : &mut HtmlPage) {
    var all = posts()
    page.appendTitle("Field Notes")
    // `@{ ... }` holds exactly one statement, so loop counters live outside.
    var index : ubigint = 0
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav><a href="/archive/">Archive</a><a href="/about/">About</a></nav>
        </header>
        <main class="content">
            <h1>Field Notes</h1>
            <p class="lede">Forty posts about building things.</p>
            <SearchBox />
            <ul class="post-list">
                @{
                    while(index < 5) {
                        var post = unsafe(&*(all.get_ptr(index)))
                        var href = string("/")
                        href.append_string(&post.slug)
                        href.append_view("/")
                        var href_view = href.to_view()
                        var title = post.title.to_view()
                        var tag = post.tag.to_view()
                        var minutes = string()
                        minutes.append_integer(post.minutes as bigint)
                        var minutes_view = minutes.to_view()
                        #html {
                            <li class="post">
                                <a href={href_view}>{title}</a>
                                <span class="tag">{tag}</span>
                                <span class="minutes">{minutes_view} min</span>
                            </li>
                        }
                        index = index + 1
                    }
                }
            </ul>
            <p><a href="/archive/">All 40 posts</a></p>
        </main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

func render_post(page : &mut HtmlPage, post : &Post) {
    page.appendTitle(post.title.to_view())
    var description = string("A note about ")
    description.append_string(&post.title)
    var desc_view = description.to_view()
    var head = Head { description : desc_view }
    page.set_head(&head)
    var html = markdown_html(post)
    var html_view = html.to_view()
    var tag = post.tag.to_view()
    var tag_href = string("/tags/")
    tag_href.append_string(&post.tag)
    tag_href.append_view("/")
    var tag_href_view = tag_href.to_view()
    var minutes = string()
    minutes.append_integer(post.minutes as bigint)
    var minutes_view = minutes.to_view()
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav><a href="/archive/">Archive</a><a href="/about/">About</a></nav>
        </header>
        <main class="content">
            <article class="post">
                <h1>{post.title.to_view()}</h1>
                <p class="meta">
                    <a href={tag_href_view} class="tag">{tag}</a>
                    <span class="minutes">{minutes_view} min</span>
                </p>
                <div class="body">{html_view}</div>
            </article>
            <p><a href="/">Back to the index</a></p>
        </main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

func render_tag(page : &mut HtmlPage, tag : string_view, all : &vector<Post>, matches : &vector<ubigint>) {
    var title = string("Tag: ")
    title.append_view(&tag)
    var title_view = title.to_view()
    page.appendTitle(&title_view)
    var index : ubigint = 0
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav><a href="/archive/">Archive</a><a href="/about/">About</a></nav>
        </header>
        <main class="content">
            <h1>{title.to_view()}</h1>
            <SearchBox />
            <ul class="post-list">
                @{
                    while(index < matches.size()) {
                        var post_index = unsafe(*matches.get_ptr(index))
                        var post = unsafe(&*(all.get_ptr(post_index)))
                        var href = string("/")
                        href.append_string(&post.slug)
                        href.append_view("/")
                        var href_view = href.to_view()
                        #html {
                            <li class="post"><a href={href_view}>{post.title.to_view()}</a></li>
                        }
                        index = index + 1
                    }
                }
            </ul>
        </main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

func render_archive(page : &mut HtmlPage, all : &vector<Post>) {
    page.appendTitle("Archive")
    var index : ubigint = 0
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav><a href="/archive/">Archive</a><a href="/about/">About</a></nav>
        </header>
        <main class="content">
            <h1>Archive</h1>
            <SearchBox />
            <ul class="post-list">
                @{
                    while(index < all.size()) {
                        var post = unsafe(&*(all.get_ptr(index)))
                        var href = string("/")
                        href.append_string(&post.slug)
                        href.append_view("/")
                        var href_view = href.to_view()
                        #html {
                            <li class="post">
                                <a href={href_view}>{post.title.to_view()}</a>
                                <span class="tag">{post.tag.to_view()}</span>
                            </li>
                        }
                        index = index + 1
                    }
                }
            </ul>
        </main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

func render_about(page : &mut HtmlPage) {
    page.appendTitle("About")
    #html {
        <header class="site">
            <a href="/" class="brand">Field Notes</a>
            <nav><a href="/archive/">Archive</a><a href="/about/">About</a></nav>
        </header>
        <main class="content">
            <h1>About</h1>
            <p>Forty generated posts, five tag pages, an archive, and this page — the whole
            site is one build.</p>
        </main>
        <footer class="site"><p>Generated by a second probe app.</p></footer>
    }
}

public func main() : int {
    var site = web::Static.make("lang/compiled/blog_probe", "blog", "assets")
    site.set_minify(true)
    site.set_gzip(true)
    // `profile.json` carries per-route bytes and chunk composition, so the
    // measurement comes from the framework rather than from `du` alone.
    site.set_profile(true)
    site.export_sitemap("https://notes.example", true)

    var all = posts()

    // `Static.add` stores the *view* of each path, so every path has to stay alive
    // until the build. One reserved vector does that (reserve first: a reallocation
    // would move short strings and invalidate the views already handed over).
    var page_paths = vector<string>()
    page_paths.reserve(80)

    var index = HtmlPage()
    site.add(&mut index, "index.html")
    index.defaultUniversalSetup()
    render_index(&mut index)

    var archive = HtmlPage()
    site.add(&mut archive, "archive/index.html")
    archive.defaultUniversalSetup()
    render_archive(&mut archive, &all)

    var about = HtmlPage()
    site.add(&mut about, "about/index.html")
    about.defaultUniversalSetup()
    render_about(&mut about)

    var post_index : ubigint = 0
    while(post_index < all.size()) {
        var post = unsafe(&*(all.get_ptr(post_index)))
        var page = HtmlPage()
        var path = string(post.slug.to_view())
        path.append_view("/index.html")
        page_paths.push_back(path)
        var stored = unsafe(&*page_paths.get_ptr(page_paths.size() - 1u))
        var path_view = stored.to_view()
        site.add(&mut page, path_view)
        page.defaultUniversalSetup()
        render_post(&mut page, post)
        post_index = post_index + 1
    }

    // One page per tag, each listing its own posts.
    var tags = vector<string>()
    tags.push_back(string("engineering"))
    tags.push_back(string("design"))
    tags.push_back(string("notes"))
    tags.push_back(string("release"))
    var tag_index : ubigint = 0
    while(tag_index < tags.size()) {
        var tag = unsafe(&*(tags.get_ptr(tag_index)))
        var matches = vector<ubigint>()
        var i : ubigint = 0
        while(i < all.size()) {
            var post = unsafe(&*(all.get_ptr(i)))
            if(post.tag.to_view().equals(&tag.to_view())) {
                matches.push_back(i)
            }
            i = i + 1
        }
        var page = HtmlPage()
        var path = string("tags/")
        path.append_string(tag)
        path.append_view("/index.html")
        page_paths.push_back(path)
        var stored = unsafe(&*page_paths.get_ptr(page_paths.size() - 1u))
        var path_view = stored.to_view()
        site.add(&mut page, path_view)
        page.defaultUniversalSetup()
        render_tag(&mut page, tag.to_view(), &all, &matches)
        tag_index = tag_index + 1
    }

    var built = site.build()
    var msg = site.error_message()
    unsafe {
        printf("build=%d msg=%.*s pages=%zu artifacts=%zu chunked=%zu retained=%zu\n",
            built as int, msg.size() as int, msg.data(),
            site.page_count(), site.artifact_count(),
            site.chunked_unit_count(), site.retained_unit_count())
    }
    if(!built) { return 1 }

    var bundle = string_of(site.bundle_js_url())
    var bundle_view = bundle.to_view()
    unsafe {
        printf("bundle=%.*s\n", bundle_view.size() as int, bundle_view.data())
    }

    // Answer one pre-rendered route in memory: the static half of the serving
    // contract (`respond` costs a map lookup plus a memcpy).
    var answered = site.respond(string_view("/post-07/"))
    unsafe {
        printf("respond status=%d bytes=%zu\n", answered.status as int, answered.body.size())
    }

    var finished = site.finish()
    unsafe { printf("finish=%d\n", finished as int) }
    return 0
}

func string_of(v : string_view) : string {
    var out = string()
    out.append_view(&v)
    return out
}
