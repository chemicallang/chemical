using namespace tls
using namespace crypto
@test public func TEST_ecdh_k3_known(env : &mut TestEnv) {
    var k:[32]u8; var ki:size_t=0; while(ki<31){k[ki]=0; ki+=1}; k[31]=3
    var G:[65]u8; G[0]=0x04
    var Gx_int = [0x6B,0x17,0xD1,0xF2,0xE1,0x2C,0x42,0x47,0xF8,0xBC,0xE6,0xE5,0x63,0xA4,0x40,0xF2,
              0x77,0x03,0x7D,0x81,0x2D,0xEB,0x33,0xA0,0xF4,0xA1,0x39,0x45,0xD8,0x98,0xC2,0x96]
    var Gy_int = [0x4F,0xE3,0x42,0xE2,0xFE,0x1A,0x7F,0x9B,0x8E,0xE7,0xEB,0x4A,0x7C,0x0F,0x9E,0x16,
              0x2B,0xCE,0x33,0x57,0x6B,0x31,0x5E,0xCE,0xCB,0xB6,0x40,0x68,0x37,0xBF,0x51,0xF5]
    var gi:size_t=0; while(gi<32){G[1+gi]=Gx_int[gi] as u8; gi+=1}
    gi=0; while(gi<32){G[33+gi]=Gy_int[gi] as u8; gi+=1}
    // Expected 3*G.x from Python
    var exp32:[32]u8 = [0x5E,0xCB,0xE4,0xD1,0xA6,0x33,0x0A,0x44,0xC8,0xF7,0xEF,0x95,0x1D,0x4B,0xF1,0x65,
                        0xE6,0xC6,0xB7,0x21,0xEF,0xAD,0xA9,0x85,0xFB,0x41,0x66,0x1B,0xC6,0xE7,0xFD,0x6C]
    var ctx:ECDHContext; ecdh_init(&raw mut ctx)
    var ret = mpi_read_binary(&raw mut ctx.priv_key, &raw k[0], 32)
    if(ret<0){env.error("k=3 read failed");return}else{}
    ctx.is_init=true
    var shared:[32]u8
    ret = ecdh_compute_shared(&raw mut ctx, &raw G[0], 65, &raw mut shared[0], 32)
    if(ret<0){printf("[K3] ret=%d\n",ret); env.error("k=3 failed");return}else{}
    if(!test_bytes_eq(&raw shared[0], &raw exp32[0], 32)){env.error("k=3 mismatch")}else{}
}
