    var handshake_hash : [32]u8 = [0x86, 0x4B, 0x05, 0xF1, 0x43, 0x78, 0x76, 0x61, 0x70, 0x8F, 0x0A, 0x16, 0x2C, 0x52, 0x17, 0x03, 0x68, 0xDE, 0xF8, 0xFA, 0x53, 0xF9, 0x42, 0x60, 0x1F, 0x93, 0x3B, 0x2D, 0xB8, 0xEE, 0x99, 0xC0]
