import lab
import std
import "@std/build.lab" as stdMod
import "@fs/build.lab" as fsMod
import "@compiler/build.lab" as compilerMod
import "@transformer/build.lab" as transformerMod

public func build(ctx : *mut BuildContext, user_job : *mut LabJob) : *mut Module {

    var curr_file_path = lab::get_my_path();
    const cached = ctx.get_cached(user_job, &curr_file_path);
    if(cached != null) {
        return cached;
    }

    var std_module = stdMod.build(ctx, user_job)
    var fs_module = fsMod.build(ctx, user_job)
    var compiler_module = compilerMod.build(ctx, user_job)
    var transformer_module = transformerMod.build(ctx, user_job)

    var deps : []*mut Module = [ std_module, fs_module, compiler_module, transformer_module ]
    var srcPath = lab::rel_path_to("src")
    const module = ctx.chemical_dir_module(std::string_view(""), std::string_view("refgen"), srcPath.to_view(), std::span<*mut Module>(deps, 4));

    ctx.index_cbi_fn(user_job as *mut LabJobCBI, "transformer_main", "transformer_main", CBIFunctionType.TransformerMain)

    ctx.set_cached(user_job, &curr_file_path, module)
    return module;
}
