import lab
import std

import "@cstd/build.lab" as cstdMod
import "@std/build.lab" as stdMod
import "@compiler/build.lab" as compilerMod
import "@css_parser/build.lab" as cssParser
import "@css_ide/build.lab" as cssIdeMod
import "@html_comp/build.lab" as htmlCompMod

using namespace std;

public func build(ctx : *mut BuildContext, user_job : *mut LabJob) : *mut Module {

    const curr_file_path = lab::get_my_path();
    const previous_module = ctx.get_cached(user_job, &curr_file_path);
    if(previous_module != null) return previous_module;
    const empty_module = ctx.empty_module(std::string_view(""), std::string_view("css_cbi"));
    ctx.set_cached(user_job, &curr_file_path, empty_module)

    const cbi_name = std::string_view("css");
    if(ctx.contains_cbi(&cbi_name)) {
        return empty_module;
    }
    ctx.set_contains_cbi(&cbi_name)

    // creating a marker annotation named 'component' so styled components are
    // recognized as components by the html converter (#html / #universal JSX)
    const controller = ctx.getAnnotationController()
    controller.createMarkerAnnotation(std::string_view("component"))

    var cbi = ctx.build_cbi(&cbi_name)
    const job = cbi;

    // makes sure this job is done before the user_job
    ctx.put_job_before(job, user_job)

    var std_module = stdMod.build(ctx, job);
    if(std_module == null) {
        return null
    }

    // the cstd module
    var cstd_module = cstdMod.build(ctx, job);
    if(cstd_module == null) {
        return null
    }

    // the compiler module
    var compiler_module = compilerMod.build(ctx, job);
    if(compiler_module == null) {
        return null
    }

    // html parser module
    var css_parser = cssParser.build(ctx, job)
    if(css_parser == null) {
        return null
    }

    // only compile html ide module in lsp
    var cssIde : *mut Module = null
    comptime if(def.lsp) {
        cssIde = cssIdeMod.build(ctx, job)
        if(cssIde == null) {
            return null;
        }
    } else {
        cssIde = css_parser
    }

    // the html component module (for StyledComponent / ComponentSignature)
    var html_comp_module = htmlCompMod.build(ctx, job)
    if(html_comp_module == null) {
        return null
    }

    const dependencies = [ cstd_module, std_module, compiler_module, css_parser, cssIde, html_comp_module ]
    var srcPath = lab::rel_path_to("src")
    const module = ctx.chemical_dir_module(std::string_view(""), std::string_view("css_cbi"), srcPath.to_view(), dependencies);
    ctx.add_module(cbi, module);

    ctx.index_def_cbi_fn(cbi, std::string_view("css_initializeLexer"), CBIFunctionType.InitializeLexer);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_parseMacroValue"), CBIFunctionType.ParseMacroValue);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_parseMacroNode"), CBIFunctionType.ParseMacroNode);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_symResNode"), CBIFunctionType.SymResNode);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_symResValue"), CBIFunctionType.SymResValue);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_replacementNode"), CBIFunctionType.ReplacementNode);
    ctx.index_def_cbi_fn(cbi, std::string_view("css_replacementValue"), CBIFunctionType.ReplacementValue);

    // styled components (#styled macro) reuse the css lexer + plugin machinery
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_initializeLexer"), CBIFunctionType.InitializeLexer);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_parseMacroNode"), CBIFunctionType.ParseMacroTopLevelNode);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_symResDeclareNode"), CBIFunctionType.SymResDeclareTopLevelNode);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_symResSigNode"), CBIFunctionType.SymResLinkSignatureNode);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_symResNode"), CBIFunctionType.SymResNode);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_replacementNodeDeclare"), CBIFunctionType.ReplacementNodeDeclare);
    ctx.index_cbi_fn(cbi, std::string_view("styled"), std::string_view("styled_replacementNode"), CBIFunctionType.ReplacementNode);

    comptime if(def.lsp) {
        // this will let the compiler know that methods are present
        ctx.index_def_cbi_fn(cbi, std::string_view("css_semanticTokensPut"), CBIFunctionType.SemanticTokensPut);
        ctx.index_def_cbi_fn(cbi, std::string_view("css_foldingRangesPut"), CBIFunctionType.FoldingRangesPut);
    }

    return empty_module;

}